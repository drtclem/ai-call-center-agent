# Copy to .env and fill in. Never commit .env.
# The app reads ENV, APP_TODAY, DB_PATH, the model keys, STAFF_PASSWORD, REVIEWER_PASSWORD and VISITOR_SALT.

# development (default) or production. production turns off /docs, /redoc, and /openapi.json.
ENV=development
# Business "today" for the live app and evals (D10). Default is Meridian's dataset date.
APP_TODAY=2026-10-16
# Runtime DB copy (D13). Default var/meridian.sqlite in development; REQUIRED in production
# (a file on the Railway volume), or the app refuses to start.
DB_PATH=var/meridian.sqlite
# Model keys (D7, D9): Anthropic for the agent, OpenAI as the fallback and for KB embeddings.
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Staff pages (/staff) are off unless this is set, 16+ characters (D12, T14).
STAFF_PASSWORD=
# Optional read-only staff login for reviewers (sees the dashboard, can't reset, delete or close).
# 16+ characters and different from STAFF_PASSWORD; safe to publish in the README.
REVIEWER_PASSWORD=
# Salt for hashed visitor IPs (D14, D17). Without it each restart picks a new one.
VISITOR_SALT=

GITLAB_TOKEN=your-project-access-token  # project access token, Maintainer, scope api; used by Claude to merge 🔒 MRs (D1). Real tokens start with glpat-.
RAILWAY_TOKEN=your-railway-project-token  # CI deploys only; store as a masked GitLab CI variable (D13)
OPENROUTER_API_KEY=your-openrouter-key  # Jev via OpenRouter, discovery labeler 2 (D2); offline only
LANGFUSE_PUBLIC_KEY=pk-lf-your-key  # optional, local dev traces only, never production (D15)
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
